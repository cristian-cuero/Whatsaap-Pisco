{
  "operations": [
    {
      "id": "consultar_contrato",
      "name": "Consultar contrato",
      "description": "Consulta los contratos asociados a una cédula.",
      "enabled": true,
      "method": "GET",
      "path": "/api/contrato/consultaraAfiliado",
      "auth": "pisco",
      "parameters": {
        "cedula": {
          "type": "string",
          "required": true,
          "source": "user"
        }
      },
      "query": {
        "cedula": "{{cedula}}"
      }
    },
    {
      "id": "pagar_contrato",
      "name": "Pagar contrato",
      "description": "Genera un enlace de pago para un contrato existente. Verifica el contrato y solicita la cantidad de cuotas.",
      "enabled": true,
      "method": "POST",
      "path": "/api/contrato/crearLinkPago",
      "auth": "pisco",
      "parameters": {
        "cedula": {
          "type": "string",
          "required": true,
          "source": "user"
        },
        "contrato": {
          "type": "string",
          "required": true,
          "source": "user"
        },
        "cuotas": {
          "type": "number",
          "required": true,
          "source": "user"
        }
      }
    }
  ]
}
